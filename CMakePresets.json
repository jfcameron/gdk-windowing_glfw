{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GDKWINDOWING_GLFW_BUILD_TESTS": "ON",
        "GDKWINDOWING_GLFW_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / gcc",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / clang",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "linux-gcc-ci",
      "displayName": "Linux / gcc / warnings are errors",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-ci",
      "displayName": "Linux / clang / warnings are errors",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror"
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux / clang / address + undefined sanitizers",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "linux-clang-libcxx",
      "displayName": "Linux / clang / libc++",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "linux-docs",
      "displayName": "Linux / documentation",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "GDKWINDOWING_GLFW_BUILD_TESTS": "OFF",
        "GDKWINDOWING_GLFW_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-ci",
      "displayName": "Windows / MSVC / warnings are errors",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /WX /EHsc /permissive- /utf-8"
      }
    },
    {
      "name": "windows-msvc-x86",
      "displayName": "Windows / MSVC / 32-bit x86",
      "inherits": "windows-msvc",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "cacheVariables": {}
    },
    {
      "name": "windows-msvc-arm64",
      "displayName": "Windows / MSVC / ARM64",
      "description": "Run on an ARM64 machine to run the tests.",
      "inherits": "windows-msvc",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "cacheVariables": {}
    },
    {
      "name": "windows-clang-cl",
      "displayName": "Windows / clang-cl",
      "description": "Needs the Visual Studio component \"C++ Clang tools for Windows\".",
      "inherits": "windows-msvc",
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      },
      "cacheVariables": {}
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows / MinGW-w64",
      "description": "Run from an MSYS2 shell; its g++, or clang++ given as CMAKE_CXX_COMPILER.",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "emscripten",
      "displayName": "Emscripten / wasm",
      "description": "Configure with `emcmake cmake --preset emscripten`. The demo runs in a browser; the tests need a window system, so they are built, not run.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fexceptions -Wall -Wextra",
        "CMAKE_EXE_LINKER_FLAGS": "-fexceptions",
        "GDKWINDOWING_GLFW_BUILD_DEMO": "ON"
      }
    },
    {
      "name": "linux-gcc-demo",
      "inherits": "linux-gcc",
      "description": "the demo window",
      "cacheVariables": {
        "GDKWINDOWING_GLFW_BUILD_DEMO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci"
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-docs",
      "configurePreset": "linux-docs"
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-clang-libcxx",
      "configurePreset": "linux-clang-libcxx"
    },
    {
      "name": "windows-msvc-x86",
      "configurePreset": "windows-msvc-x86",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-arm64",
      "configurePreset": "windows-msvc-arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten"
    },
    {
      "name": "linux-gcc-demo",
      "configurePreset": "linux-gcc-demo"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-ci",
      "configurePreset": "linux-gcc-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-ci",
      "configurePreset": "linux-clang-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-ci",
      "configurePreset": "windows-msvc-ci",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-clang-libcxx",
      "configurePreset": "linux-clang-libcxx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-x86",
      "configurePreset": "windows-msvc-x86",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-msvc-arm64",
      "configurePreset": "windows-msvc-arm64",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
